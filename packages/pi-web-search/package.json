{
  "name": "@steveimm/pi-web-search",
  "version": "0.1.0",
  "description": "Web search and readable page fetching for Pi",
  "scripts": {
    "check": "tsc --noEmit"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveimm/pi-ext-collection.git",
    "directory": "packages/pi-web-search"
  },
  "homepage": "https://github.com/steveimm/pi-ext-collection/tree/main/packages/pi-web-search#readme",
  "bugs": {
    "url": "https://github.com/steveimm/pi-ext-collection/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "*.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.1",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@types/turndown": "5.0.6",
    "typebox": "1.3.27"
  }
}
