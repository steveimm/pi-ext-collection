{
  "name": "pi-ext-collection",
  "description": "Independently installable Pi extensions",
  "scripts": {
    "check": "npm run check --workspaces",
    "test": "npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test .github/scripts/test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveimm/pi-ext-collection.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/steveimm/pi-ext-collection/issues"
  },
  "homepage": "https://github.com/steveimm/pi-ext-collection#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
